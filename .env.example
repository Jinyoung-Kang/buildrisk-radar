# =============================================================================
# .env.example — 건설·부동산 위험 모니터 (값은 비워 둔 채 커밋)
#   cp .env.example .env 후 값을 채우세요. make up 은 .env 가 없으면 만들어 주고
#   ADMIN_TOKEN 이 비어 있으면 무작위 값으로 채웁니다.
#   값 뒤에 줄 끝 주석을 달지 마세요 (docker compose 가 값으로 읽습니다).
# =============================================================================

# ---- 외부 API 키 (서버에서만 사용) ----
# 금융감독원 Open DART 인증키 (crtfc_key, 40자)
DART_API_KEY=
# KOSIS 공유서비스 사용자 인증키 (apiKey)
KOSIS_API_KEY=
# 한국부동산원 R-ONE 부동산통계 Open API 인증키 (KEY)
REB_API_KEY=
# SGIS 서비스 ID / 보안 Key
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
# V-World 데이터 API 인증키와 키 발급 시 등록한 서비스 URL(도메인)
VWORLD_API_KEY=
VWORLD_DOMAIN=http://localhost:3400
# 공공데이터포털 일반 인증키 — 국토부 아파트 매매 실거래가 · 금융위 주식시세 · 한국부동산원 청약홈 분양정보 (세 API 모두 활용신청 승인 필요)
DATA_GO_KR_KEY=
# data.go.kr API 별 자체 일일 상한 (마이페이지의 상세기능별 트래픽보다 낮게)
DATA_GO_KR_DAILY_CALL_LIMIT=9000
# 청약홈 분양정보(api.odcloud.kr) 자체 일일 상한 — 처음 수집(2023-01~)은 주택형 호출까지 약 1,400건이라 한도에 닿으면 다음 실행에서 이어감
APPLYHOME_DAILY_CALL_LIMIT=1000

# ---- 브라우저에 노출되는 유일한 키 ----
# 카카오 JavaScript 키 (플랫폼 Web 도메인에 http://localhost:3400 등록, 카카오맵 사용 ON)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 화면 바닥글의 최종 수정일 (YYYY-MM-DD) — 비워 두면 make up · make build 가 마지막 커밋 날짜(KST)로 채움
# BUILDRISK_LAST_UPDATED=

# ---- 비밀값 — 비워 두면 make env(up) 가 무작위로 채웁니다. 커밋 금지 ----
# 서비스 토큰 (스크립트·자동화용 X-Admin-Token, ADMIN 권한)
ADMIN_TOKEN=
# 화면 로그인 (admin: 규칙·배치·매핑·감사 / analyst: 경보 확인). 12자 이상
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=
# DB 소유자 계정(buildrisk — 마이그레이션 전용, api 와 단독 batch 에만 전달). 비우면 compose 기본값(로컬 전용).
# DB 를 처음 만들 때만 적용되므로, 이미 만든 DB 에서 바꾸려면 ALTER ROLE 을 먼저 하고 값을 맞추세요 (make env 가 채우지 않음)
POSTGRES_PASSWORD=
# DB 런타임 계정(buildrisk_app, DML 전용) · Redis · Grafana
DB_APP_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# 알림 웹훅 주소 · 서명 비밀 암호화 키 (비우면 make env 가 채움 — 바꾸면 등록한 웹훅을 다시 등록해야 함)
NOTIFY_SECRET_KEY=
# 웹훅 메시지 속 화면 링크의 기준 주소 (비우면 http://localhost:3400)
PUBLIC_BASE_URL=
# HTTPS 뒤에서 운영하면 true (세션·CSRF 쿠키 Secure)
COOKIE_SECURE=false
# IP 당 분당 CSV 내려받기 한도 (비우면 30, 0 = 끔)
EXPORT_LIMIT_PER_MINUTE=

# ---- 배치 파라미터 ----
# DART 일일 호출 상한 (NFR-03, 020 기준 20,000건보다 낮게)
DART_DAILY_CALL_LIMIT=15000
# 재무제표 수집 연도 범위 (최근 5개년)
FS_FROM_YEAR=2021
# 청약홈 분양 공고를 처음 받을 모집공고 월 (YYYY-MM)
PRESALE_FROM_YM=2023-01
# 스케줄러(cron) 사용 여부 — worker 가 주기마다 요청 큐에 넣음. 로컬 데모에서는 수동 실행 권장
BATCH_SCHEDULING_ENABLED=false
# 외부 API Step 의 청크 안 동시 호출 수 (1 = 순차)
BATCH_API_CONCURRENCY=4
