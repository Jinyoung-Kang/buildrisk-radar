# =============================================================================
# .env.example — 건설·부동산 위험 모니터 (값은 비워 둔 채 커밋)
#   cp .env.example .env 후 값을 채우세요. make up 은 .env 가 없으면 만들어 주고
#   ADMIN_TOKEN 이 비어 있으면 무작위 값으로 채웁니다.
#   값 뒤에 줄 끝 주석을 달지 마세요 (docker compose 가 값으로 읽습니다).
# =============================================================================

# ---- 외부 API 키 (서버에서만 사용) ----
# 금융감독원 Open DART 인증키 (crtfc_key, 40자)
DART_API_KEY=
# KOSIS 공유서비스 사용자 인증키 (apiKey)
KOSIS_API_KEY=
# 한국부동산원 R-ONE 부동산통계 Open API 인증키 (KEY)
REB_API_KEY=
# SGIS 서비스 ID / 보안 Key
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
# V-World 데이터 API 인증키와 키 발급 시 등록한 서비스 URL(도메인)
VWORLD_API_KEY=
VWORLD_DOMAIN=http://localhost:3400

# ---- 브라우저에 노출되는 유일한 키 ----
# 카카오 JavaScript 키 (플랫폼 Web 도메인에 http://localhost:3400 등록, 카카오맵 사용 ON)
NEXT_PUBLIC_KAKAO_JS_KEY=

# ---- 관리 API 보호 토큰 (PUT /rules/*, POST /batch/*) — make up 이 비어 있으면 자동 생성 ----
ADMIN_TOKEN=

# ---- 배치 파라미터 ----
# DART 일일 호출 상한 (NFR-03, 020 기준 20,000건보다 낮게)
DART_DAILY_CALL_LIMIT=15000
# 재무제표 수집 연도 범위 (최근 5개년)
FS_FROM_YEAR=2021
# 스케줄러(cron) 사용 여부 — 로컬 데모에서는 수동 실행(make batch-all)을 권장
BATCH_SCHEDULING_ENABLED=false
