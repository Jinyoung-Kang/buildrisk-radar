# AWS 데모 배포용 .env — 이름만 적습니다(값은 서버의 .env 에만). compose.aws.yml · ADR-031 참고.

# ── 배포 전용 ──
RDS_HOST=
RDS_PORT=
PUBLIC_ORIGIN=

# ── DB 계정: 소유자(Flyway)는 RDS 초기화 스크립트가 같은 비밀번호로 만들고, 런타임 계정은 afterMigrate 가 만듦 ──
POSTGRES_PASSWORD=
DB_APP_PASSWORD=

# ── 앱 ──
REDIS_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ANALYST_USERNAME=
ANALYST_PASSWORD=
ADMIN_TOKEN=
GRAFANA_ADMIN_PASSWORD=
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 외부 API (worker · batch) ──
DART_API_KEY=
KOSIS_API_KEY=
REB_API_KEY=
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
VWORLD_API_KEY=
DATA_GO_KR_KEY=
